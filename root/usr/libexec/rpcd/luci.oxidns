#!/bin/sh

set -eu

UCI_PACKAGE="oxidns"
UCI_SECTION="main"
OXIDNS_BIN="/usr/bin/oxidns"
DEFAULT_CONFIG_PATH="/etc/oxidns/config.yaml"
DEFAULT_WORKING_DIR="/var/lib/oxidns"
DEFAULT_SERVICE_NAME="oxidns"
DEFAULT_API_BASE_URL="http://127.0.0.1:9199/api"
DEFAULT_MANIFEST_URL="https://svenshi.github.io/oxidns-openwrt-packages/manifest.json"
TMP_ROOT="${TMPDIR:-/tmp}"

CONFIG_PATH="$DEFAULT_CONFIG_PATH"
WORKING_DIR="$DEFAULT_WORKING_DIR"
SERVICE_NAME="$DEFAULT_SERVICE_NAME"
API_BASE_URL="$DEFAULT_API_BASE_URL"
MANIFEST_URL="$DEFAULT_MANIFEST_URL"
DOWNLOAD_PROXY=""
GITHUB_TOKEN=""

json_escape_stream() {
	awk 'BEGIN { ORS = "" }
	{
		gsub(/\\/, "\\\\");
		gsub(/"/, "\\\"");
		gsub(/\t/, "\\t");
		gsub(/\r/, "\\r");
		if (NR > 1)
			printf "\\n";
		printf "%s", $0;
	}'
}

json_string() {
	printf '"'
	printf '%s' "$1" | json_escape_stream
	printf '"'
}

json_file_string() {
	printf '"'
	if [ -r "$1" ]; then
		json_escape_stream < "$1"
	fi
	printf '"'
}

json_bool() {
	if [ "${1:-0}" = "1" ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

json_error() {
	printf '{'
	printf '"ok":false,'
	printf '"code":'
	json_string "$1"
	printf ',"message":'
	json_string "$2"
	printf '}\n'
}

uci_get() {
	KEY="$1"
	DEFAULT="$2"
	if command -v uci >/dev/null 2>&1; then
		uci -q get "$UCI_PACKAGE.$UCI_SECTION.$KEY" 2>/dev/null || printf '%s' "$DEFAULT"
	else
		printf '%s' "$DEFAULT"
	fi
}

load_settings() {
	SERVICE_NAME="$(uci_get service_name "$DEFAULT_SERVICE_NAME")"
	CONFIG_PATH="$(uci_get config_path "$DEFAULT_CONFIG_PATH")"
	WORKING_DIR="$(uci_get working_dir "$DEFAULT_WORKING_DIR")"
	API_BASE_URL="$(uci_get api_base_url "$DEFAULT_API_BASE_URL")"
	MANIFEST_URL="$(uci_get manifest_url "$DEFAULT_MANIFEST_URL")"
	DOWNLOAD_PROXY="$(uci_get download_proxy '')"
	GITHUB_TOKEN="$(uci_get github_token '')"
}

init_script() {
	printf '/etc/init.d/%s' "$SERVICE_NAME"
}

detect_package_manager() {
	if command -v apk >/dev/null 2>&1; then
		printf 'apk'
	elif command -v opkg >/dev/null 2>&1; then
		printf 'opkg'
	else
		printf 'none'
	fi
}

package_format() {
	case "$1" in
		apk) printf 'apk' ;;
		opkg) printf 'ipk' ;;
		*) printf 'none' ;;
	esac
}

package_arch() {
	PM="$1"
	case "$PM" in
		apk)
			apk --print-arch 2>/dev/null || printf 'unknown'
			;;
		opkg)
			opkg print-architecture 2>/dev/null |
				awk '$1 == "arch" { arch = $2 } END { if (arch) print arch; else print "unknown" }'
			;;
		*)
			printf 'unknown'
			;;
	esac
}

package_installed() {
	PM="$1"
	case "$PM" in
		apk)
			apk info -e oxidns >/dev/null 2>&1
			;;
		opkg)
			opkg status oxidns 2>/dev/null | grep -q '^Status: .* installed'
			;;
		*)
			return 1
			;;
	esac
}

package_version() {
	PM="$1"
	case "$PM" in
		apk)
			apk info -v oxidns 2>/dev/null | sed -n '1s/^oxidns-//p'
			;;
		opkg)
			opkg status oxidns 2>/dev/null | sed -n 's/^Version: //p' | sed -n '1p'
			;;
	esac
}

service_enabled() {
	INIT="$(init_script)"
	[ -x "$INIT" ] && "$INIT" enabled >/dev/null 2>&1
}

service_running() {
	INIT="$(init_script)"
	if [ -x "$INIT" ] && "$INIT" status >/dev/null 2>&1; then
		return 0
	fi
	if command -v pgrep >/dev/null 2>&1 && pgrep -x oxidns >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

api_fetch() {
	PATH_PART="$1"
	URL="${API_BASE_URL%/}/$PATH_PART"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 2 -O - "$URL" 2>/dev/null
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 2 -O - "$URL" 2>/dev/null
	elif command -v curl >/dev/null 2>&1; then
		curl -fsS --max-time 2 "$URL" 2>/dev/null
	else
		return 1
	fi
}

api_post_empty() {
	PATH_PART="$1"
	URL="${API_BASE_URL%/}/$PATH_PART"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 5 --post-data '' -O - "$URL" 2>/dev/null
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 5 --post-data '' -O - "$URL" 2>/dev/null
	elif command -v curl >/dev/null 2>&1; then
		curl -fsS --max-time 5 -X POST "$URL" 2>/dev/null
	else
		return 1
	fi
}

build_info_json() {
	if [ -x "$OXIDNS_BIN" ]; then
		"$OXIDNS_BIN" build-info 2>/dev/null || true
	fi
}

emit_package_manager() {
	PM="$(detect_package_manager)"
	FORMAT="$(package_format "$PM")"
	ARCH="$(package_arch "$PM")"
	printf '{'
	printf '"ok":true,'
	printf '"manager":'
	json_string "$PM"
	printf ',"format":'
	json_string "$FORMAT"
	printf ',"arch":'
	json_string "$ARCH"
	printf '}\n'
}

emit_status() {
	load_settings
	PM="$(detect_package_manager)"
	FORMAT="$(package_format "$PM")"
	ARCH="$(package_arch "$PM")"
	INSTALLED=0
	ENABLED=0
	RUNNING=0
	API_OK=0
	PKG_VERSION="$(package_version "$PM" || true)"
	BUILD_JSON="$(build_info_json)"

	if package_installed "$PM"; then INSTALLED=1; fi
	if service_enabled; then ENABLED=1; fi
	if service_running; then RUNNING=1; fi
	if api_fetch readyz >/dev/null 2>&1; then API_OK=1; fi

	printf '{'
	printf '"ok":true,'
	printf '"backend":"rpcd",'
	printf '"install_mode":'
	json_string "$(uci_get install_mode package)"
	printf ',"binary_path":'
	json_string "$OXIDNS_BIN"
	printf ',"binary_present":'
	json_bool "$([ -x "$OXIDNS_BIN" ] && printf 1 || printf 0)"
	printf ',"service":'
	json_string "$SERVICE_NAME"
	printf ',"config_path":'
	json_string "$CONFIG_PATH"
	printf ',"working_dir":'
	json_string "$WORKING_DIR"
	printf ',"api_base_url":'
	json_string "$API_BASE_URL"
	printf ',"package_manager":{"manager":'
	json_string "$PM"
	printf ',"format":'
	json_string "$FORMAT"
	printf ',"arch":'
	json_string "$ARCH"
	printf '}'
	printf ',"package":{"installed":'
	json_bool "$INSTALLED"
	printf ',"version":'
	json_string "$PKG_VERSION"
	printf '}'
	printf ',"service_status":{"running":'
	json_bool "$RUNNING"
	printf ',"enabled":'
	json_bool "$ENABLED"
	printf ',"init_script":'
	json_string "$(init_script)"
	printf '}'
	printf ',"api":{"ready":'
	json_bool "$API_OK"
	printf '}'
	printf ',"build":'
	if printf '%s' "$BUILD_JSON" | grep -q '^{'; then
		printf '%s' "$BUILD_JSON"
	else
		printf 'null'
	fi
	printf '}\n'
}

run_service() {
	load_settings
	ACTION="$1"
	INIT="$(init_script)"
	if [ ! -x "$INIT" ]; then
		json_error "service_unavailable" "init script not found: $INIT"
		return 1
	fi
	if "$INIT" "$ACTION" >/tmp/luci-oxidns-service.out 2>&1; then
		printf '{"ok":true,"action":'
		json_string "$ACTION"
		printf '}\n'
	else
		MSG="$(cat /tmp/luci-oxidns-service.out 2>/dev/null || true)"
		json_error "service_failed" "${MSG:-service action failed}"
		return 1
	fi
}

stat_mtime() {
	stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || printf ''
}

emit_config_read() {
	load_settings
	if [ ! -r "$CONFIG_PATH" ]; then
		json_error "config_not_found" "configuration file not found"
		return 1
	fi
	printf '{'
	printf '"ok":true,'
	printf '"path":'
	json_string "$CONFIG_PATH"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CONFIG_PATH")"
	printf ',"content":'
	json_file_string "$CONFIG_PATH"
	printf '}\n'
}

yaml_scalar_clean() {
	sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//; s/^'\''//; s/'\''$//'
}

basic_log_level() {
	awk '
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
		}
		top == "log" && /^[[:space:]]+level:[[:space:]]*/ {
			sub(/^[[:space:]]+level:[[:space:]]*/, "", $0);
			print $0;
			exit;
		}
	' "$CONFIG_PATH" | yaml_scalar_clean
}

basic_api_listen() {
	awk '
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
			second = "";
		}
		top == "api" && /^[[:space:]]+http:[[:space:]]*[^[:space:]#]/ {
			sub(/^[[:space:]]+http:[[:space:]]*/, "", $0);
			print $0;
			exit;
		}
		top == "api" && /^[[:space:]]+http:[[:space:]]*$/ {
			second = "http";
			next;
		}
		top == "api" && second == "http" && /^[[:space:]]+listen:[[:space:]]*/ {
			sub(/^[[:space:]]+listen:[[:space:]]*/, "", $0);
			print $0;
			exit;
		}
	' "$CONFIG_PATH" | yaml_scalar_clean
}

emit_config_basic_read() {
	load_settings
	if [ ! -r "$CONFIG_PATH" ]; then
		json_error "config_not_found" "configuration file not found"
		return 1
	fi
	printf '{'
	printf '"ok":true,'
	printf '"path":'
	json_string "$CONFIG_PATH"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CONFIG_PATH")"
	printf ',"log_level":'
	json_string "$(basic_log_level)"
	printf ',"api_http_listen":'
	json_string "$(basic_api_listen)"
	printf '}\n'
}

safe_single_line_value() {
	printf '%s' "$1" | grep -q '[\r\n]' && return 1
	return 0
}

write_basic_config_temp() {
	SOURCE_FILE="$1"
	OUT_FILE="$2"
	LOG_LEVEL="$3"
	API_LISTEN="$4"
	awk -v log_level="$LOG_LEVEL" -v api_listen="$API_LISTEN" '
		BEGIN {
			log_done = 0;
			api_done = 0;
			top = "";
			second = "";
		}
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
			second = "";
		}
		top == "log" && /^[[:space:]]+level:[[:space:]]*/ {
			print "  level: " log_level;
			log_done = 1;
			next;
		}
		top == "api" && /^[[:space:]]+http:[[:space:]]*[^[:space:]#]/ {
			print "  http:";
			print "    listen: \"" api_listen "\"";
			api_done = 1;
			second = "http";
			next;
		}
		top == "api" && /^[[:space:]]+http:[[:space:]]*$/ {
			second = "http";
			print;
			next;
		}
		top == "api" && second == "http" && /^[[:space:]]+listen:[[:space:]]*/ {
			print "    listen: \"" api_listen "\"";
			api_done = 1;
			next;
		}
		{ print }
		END {
			if (!log_done || !api_done)
				exit 42;
		}
	' "$SOURCE_FILE" > "$OUT_FILE"
}

input_value() {
	KEY="$1"
	INPUT="$2"
	if command -v jsonfilter >/dev/null 2>&1; then
		printf '%s' "$INPUT" | jsonfilter -e "@.$KEY" 2>/dev/null || true
	else
		printf '%s' "$INPUT" | sed -n "s/.*\"$KEY\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
	fi
}

validate_config_file() {
	FILE="$1"
	load_settings
	if [ ! -x "$OXIDNS_BIN" ]; then
		printf 'oxidns binary not found or not executable: %s' "$OXIDNS_BIN"
		return 1
	fi
	mkdir -p "$WORKING_DIR"
	"$OXIDNS_BIN" check -c "$FILE" -d "$WORKING_DIR" 2>&1
}

emit_config_validate() {
	INPUT="$(cat)"
	CONTENT="$(input_value content "$INPUT")"
	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-config.XXXXXX")"
	if [ -n "$CONTENT" ]; then
		printf '%s' "$CONTENT" > "$TMP_FILE"
	elif [ -r "$CONFIG_PATH" ]; then
		cp "$CONFIG_PATH" "$TMP_FILE"
	else
		rm -f "$TMP_FILE"
		json_error "config_missing" "no configuration content or file available"
		return 1
	fi
	if OUTPUT="$(validate_config_file "$TMP_FILE")"; then
		rm -f "$TMP_FILE"
		printf '{"ok":true,"message":'
		json_string "${OUTPUT:-configuration is valid}"
		printf '}\n'
	else
		rm -f "$TMP_FILE"
		json_error "config_invalid" "$OUTPUT"
		return 1
	fi
}

emit_config_save() {
	load_settings
	INPUT="$(cat)"
	CONTENT="$(input_value content "$INPUT")"
	BASE_MTIME="$(input_value base_mtime "$INPUT")"
	RELOAD="$(input_value reload "$INPUT")"

	if [ -z "$CONTENT" ]; then
		json_error "missing_content" "configuration content is required"
		return 1
	fi
	if [ -n "$BASE_MTIME" ] && [ -e "$CONFIG_PATH" ] && [ "$BASE_MTIME" != "$(stat_mtime "$CONFIG_PATH")" ]; then
		json_error "config_conflict" "configuration file changed since it was loaded"
		return 1
	fi

	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-config.XXXXXX")"
	printf '%s' "$CONTENT" > "$TMP_FILE"
	if ! OUTPUT="$(validate_config_file "$TMP_FILE")"; then
		rm -f "$TMP_FILE"
		json_error "config_invalid" "$OUTPUT"
		return 1
	fi

	mkdir -p "$(dirname "$CONFIG_PATH")"
	if [ -e "$CONFIG_PATH" ]; then
		mkdir -p "$WORKING_DIR/config-backups"
		cp "$CONFIG_PATH" "$WORKING_DIR/config-backups/config.yaml.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
	fi
	mv "$TMP_FILE" "$CONFIG_PATH"

	RELOAD_STATUS="not_requested"
	if [ "$RELOAD" = "true" ] || [ "$RELOAD" = "1" ]; then
		if api_post_empty reload >/dev/null 2>&1; then
			RELOAD_STATUS="requested"
		else
			RELOAD_STATUS="failed"
		fi
	fi

	printf '{"ok":true,"path":'
	json_string "$CONFIG_PATH"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CONFIG_PATH")"
	printf ',"reload":'
	json_string "$RELOAD_STATUS"
	printf '}\n'
}

emit_config_basic_save() {
	load_settings
	INPUT="$(cat)"
	LOG_LEVEL="$(input_value log_level "$INPUT")"
	API_LISTEN="$(input_value api_http_listen "$INPUT")"
	BASE_MTIME="$(input_value base_mtime "$INPUT")"
	RELOAD="$(input_value reload "$INPUT")"

	case "$LOG_LEVEL" in
		off|trace|debug|info|warn|error) ;;
		*)
			json_error "invalid_log_level" "log_level must be one of off, trace, debug, info, warn, error"
			return 1
			;;
	esac
	if [ -z "$API_LISTEN" ] || ! safe_single_line_value "$API_LISTEN"; then
		json_error "invalid_api_listen" "api_http_listen must be a single-line value"
		return 1
	fi
	if [ ! -r "$CONFIG_PATH" ]; then
		json_error "config_not_found" "configuration file not found"
		return 1
	fi
	if [ -n "$BASE_MTIME" ] && [ "$BASE_MTIME" != "$(stat_mtime "$CONFIG_PATH")" ]; then
		json_error "config_conflict" "configuration file changed since it was loaded"
		return 1
	fi

	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-basic.XXXXXX")"
	if ! write_basic_config_temp "$CONFIG_PATH" "$TMP_FILE" "$LOG_LEVEL" "$API_LISTEN"; then
		rm -f "$TMP_FILE"
		json_error "unsupported_basic_config" "top-level log.level and api.http.listen must already exist to use basic save"
		return 1
	fi
	if ! OUTPUT="$(validate_config_file "$TMP_FILE")"; then
		rm -f "$TMP_FILE"
		json_error "config_invalid" "$OUTPUT"
		return 1
	fi

	mkdir -p "$WORKING_DIR/config-backups"
	cp "$CONFIG_PATH" "$WORKING_DIR/config-backups/config.yaml.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
	mv "$TMP_FILE" "$CONFIG_PATH"

	RELOAD_STATUS="not_requested"
	if [ "$RELOAD" = "true" ] || [ "$RELOAD" = "1" ]; then
		if api_post_empty reload >/dev/null 2>&1; then
			RELOAD_STATUS="requested"
		else
			RELOAD_STATUS="failed"
		fi
	fi

	printf '{"ok":true,"path":'
	json_string "$CONFIG_PATH"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CONFIG_PATH")"
	printf ',"reload":'
	json_string "$RELOAD_STATUS"
	printf '}\n'
}

emit_logs_recent() {
	INPUT="$(cat)"
	LIMIT="$(input_value limit "$INPUT")"
	[ -n "$LIMIT" ] || LIMIT=200
	case "$LIMIT" in
		*[!0-9]*|'') LIMIT=200 ;;
	esac
	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-logs.XXXXXX")"
	if API_LOGS="$(api_fetch "logs?limit=$LIMIT")" && load_jshn; then
		if json_load "$API_LOGS" >/dev/null 2>&1 && json_select entries >/dev/null 2>&1; then
			json_get_keys LOG_KEYS
			: > "$TMP_FILE"
			for LOG_KEY in $LOG_KEYS; do
				json_select "$LOG_KEY" >/dev/null 2>&1 || continue
				json_get_var LOG_TS timestamp
				json_get_var LOG_LEVEL level
				json_get_var LOG_TARGET target
				json_get_var LOG_MESSAGE message
				json_select .. >/dev/null 2>&1 || true
				printf '%s [%s] %s %s\n' "$LOG_TS" "$LOG_LEVEL" "$LOG_TARGET" "$LOG_MESSAGE" >> "$TMP_FILE"
			done
			printf '{"ok":true,"source":"api","lines":['
			SEP=""
			while IFS= read -r LINE; do
				printf '%s' "$SEP"
				json_string "$LINE"
				SEP=","
			done < "$TMP_FILE"
			printf ']}\n'
			rm -f "$TMP_FILE"
			return 0
		fi
	fi
	if command -v logread >/dev/null 2>&1; then
		logread 2>/dev/null | grep -i 'oxidns' | tail -n "$LIMIT" > "$TMP_FILE" || true
	else
		: > "$TMP_FILE"
	fi
	printf '{"ok":true,"source":"logread","lines":['
	SEP=""
	while IFS= read -r LINE; do
		printf '%s' "$SEP"
		json_string "$LINE"
		SEP=","
	done < "$TMP_FILE"
	printf ']}\n'
	rm -f "$TMP_FILE"
}

download_file() {
	URL="$1"
	OUT="$2"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O "$OUT" "$URL"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -O "$OUT" "$URL"
	elif command -v curl >/dev/null 2>&1; then
		if [ -n "$DOWNLOAD_PROXY" ]; then
			curl -fsSL --proxy "$DOWNLOAD_PROXY" -o "$OUT" "$URL"
		else
			curl -fsSL -o "$OUT" "$URL"
		fi
	else
		return 1
	fi
}

sha256_file() {
	sha256sum "$1" 2>/dev/null | awk '{ print $1 }'
}

load_jshn() {
	if [ -r /usr/share/libubox/jshn.sh ]; then
		# shellcheck disable=SC1091
		. /usr/share/libubox/jshn.sh
		return 0
	fi
	return 1
}

select_manifest_package() {
	MANIFEST_FILE="$1"
	WANT_FORMAT="$2"
	WANT_ARCH="$3"

	SELECT_VERSION=""
	SELECT_COMMIT=""
	SELECT_BUNDLE=""
	SELECT_FORMAT=""
	SELECT_ARCH=""
	SELECT_RUST_TARGET=""
	SELECT_FILENAME=""
	SELECT_URL=""
	SELECT_SHA256=""
	SELECT_SIZE=""

	if ! load_jshn; then
		return 2
	fi

	json_load "$(cat "$MANIFEST_FILE")" >/dev/null 2>&1 || return 1
	json_select oxidns >/dev/null 2>&1 || return 1
	json_get_var SELECT_VERSION version
	json_get_var SELECT_COMMIT commit
	json_get_var SELECT_BUNDLE bundle
	json_select packages >/dev/null 2>&1 || return 1
	json_get_keys PACKAGE_KEYS

	for PACKAGE_KEY in $PACKAGE_KEYS; do
		json_select "$PACKAGE_KEY" >/dev/null 2>&1 || continue
		json_get_var PKG_FORMAT format
		json_get_var PKG_ARCH openwrt_arch
		json_get_var PKG_RUST_TARGET rust_target
		json_get_var PKG_FILENAME filename
		json_get_var PKG_URL url
		json_get_var PKG_SHA256 sha256
		json_get_var PKG_SIZE size
		json_select .. >/dev/null 2>&1 || true

		if [ "$PKG_FORMAT" = "$WANT_FORMAT" ] && [ "$PKG_ARCH" = "$WANT_ARCH" ]; then
			SELECT_FORMAT="$PKG_FORMAT"
			SELECT_ARCH="$PKG_ARCH"
			SELECT_RUST_TARGET="$PKG_RUST_TARGET"
			SELECT_FILENAME="$PKG_FILENAME"
			SELECT_URL="$PKG_URL"
			SELECT_SHA256="$PKG_SHA256"
			SELECT_SIZE="$PKG_SIZE"
			return 0
		fi
	done

	return 1
}

download_manifest() {
	URL="$1"
	OUT="$2"
	if ! download_file "$URL" "$OUT"; then
		json_error "manifest_download_failed" "failed to download package manifest"
		return 1
	fi
}

emit_selected_package_json() {
	printf '{'
	printf '"format":'
	json_string "$SELECT_FORMAT"
	printf ',"openwrt_arch":'
	json_string "$SELECT_ARCH"
	printf ',"rust_target":'
	json_string "$SELECT_RUST_TARGET"
	printf ',"filename":'
	json_string "$SELECT_FILENAME"
	printf ',"url":'
	json_string "$SELECT_URL"
	printf ',"sha256":'
	json_string "$SELECT_SHA256"
	printf ',"size":'
	json_string "$SELECT_SIZE"
	printf '}'
}

emit_package_check_update() {
	load_settings
	INPUT="$(cat)"
	URL="$(input_value manifest_url "$INPUT")"
	[ -n "$URL" ] || URL="$MANIFEST_URL"
	PM="$(detect_package_manager)"
	FORMAT="$(package_format "$PM")"
	ARCH="$(package_arch "$PM")"
	if [ "$PM" = "none" ]; then
		json_error "package_manager_unavailable" "opkg or apk not found"
		return 1
	fi
	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-manifest.XXXXXX")"
	if ! download_manifest "$URL" "$TMP_FILE"; then
		rm -f "$TMP_FILE"
		return 1
	fi

	if ! select_manifest_package "$TMP_FILE" "$FORMAT" "$ARCH"; then
		rm -f "$TMP_FILE"
		if [ "$PM" = "none" ]; then
			json_error "package_manager_unavailable" "opkg or apk not found"
		else
			json_error "package_not_found" "no package matches current package manager and architecture"
		fi
		return 1
	fi
	rm -f "$TMP_FILE"
	CURRENT="$(package_version "$(detect_package_manager)" || true)"
	UPDATE=0
	if [ -n "$SELECT_VERSION" ] && [ "$SELECT_VERSION" != "$CURRENT" ]; then UPDATE=1; fi
	printf '{"ok":true,"current_version":'
	json_string "$CURRENT"
	printf ',"latest_version":'
	json_string "$SELECT_VERSION"
	printf ',"update_available":'
	json_bool "$UPDATE"
	printf ',"package":'
	emit_selected_package_json
	printf '}\n'
}

emit_package_install() {
	load_settings
	INPUT="$(cat)"
	ACTION="$1"
	PM="$(detect_package_manager)"
	FORMAT="$(package_format "$PM")"
	ARCH="$(package_arch "$PM")"
	URL="$(input_value url "$INPUT")"
	EXPECTED_SHA256="$(input_value sha256 "$INPUT")"
	MANIFEST_INPUT_URL="$(input_value manifest_url "$INPUT")"
	[ -n "$MANIFEST_INPUT_URL" ] || MANIFEST_INPUT_URL="$MANIFEST_URL"

	if [ "$PM" = "none" ]; then
		json_error "package_manager_unavailable" "opkg or apk not found"
		return 1
	fi

	if [ -z "$URL" ] || [ -z "$EXPECTED_SHA256" ]; then
		MANIFEST_FILE="$(mktemp "$TMP_ROOT/oxidns-manifest.XXXXXX")"
		if ! download_manifest "$MANIFEST_INPUT_URL" "$MANIFEST_FILE"; then
			rm -f "$MANIFEST_FILE"
			return 1
		fi
		if ! select_manifest_package "$MANIFEST_FILE" "$FORMAT" "$ARCH"; then
			rm -f "$MANIFEST_FILE"
			json_error "package_not_found" "no package matches current package manager and architecture"
			return 1
		fi
		rm -f "$MANIFEST_FILE"
		URL="$SELECT_URL"
		EXPECTED_SHA256="$SELECT_SHA256"
	fi

	PKG_FILE="$(mktemp "$TMP_ROOT/oxidns-package.XXXXXX")"
	if ! download_file "$URL" "$PKG_FILE"; then
		rm -f "$PKG_FILE"
		json_error "package_download_failed" "failed to download package"
		return 1
	fi

	ACTUAL_SHA256="$(sha256_file "$PKG_FILE")"
	if [ -z "$ACTUAL_SHA256" ] || [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
		rm -f "$PKG_FILE"
		json_error "package_checksum_failed" "package SHA256 does not match manifest"
		return 1
	fi

	case "$PM" in
		opkg)
			if opkg install "$PKG_FILE" >/tmp/luci-oxidns-package.out 2>&1; then
				rm -f "$PKG_FILE"
				printf '{"ok":true,"action":'
				json_string "$ACTION"
				printf '}\n'
			else
				MSG="$(cat /tmp/luci-oxidns-package.out 2>/dev/null || true)"
				rm -f "$PKG_FILE"
				json_error "package_install_failed" "${MSG:-opkg install failed}"
				return 1
			fi
			;;
		apk)
			if apk add --allow-untrusted "$PKG_FILE" >/tmp/luci-oxidns-package.out 2>&1; then
				rm -f "$PKG_FILE"
				printf '{"ok":true,"action":'
				json_string "$ACTION"
				printf '}\n'
			else
				MSG="$(cat /tmp/luci-oxidns-package.out 2>/dev/null || true)"
				rm -f "$PKG_FILE"
				json_error "package_install_failed" "${MSG:-apk add failed}"
				return 1
			fi
			;;
	esac
}

emit_package_remove() {
	load_settings
	PM="$(detect_package_manager)"
	run_service stop >/dev/null 2>&1 || true
	case "$PM" in
		opkg)
			if opkg remove oxidns >/tmp/luci-oxidns-package.out 2>&1; then
				printf '{"ok":true,"action":"remove"}\n'
			else
				json_error "package_remove_failed" "$(cat /tmp/luci-oxidns-package.out 2>/dev/null || true)"
				return 1
			fi
			;;
		apk)
			if apk del oxidns >/tmp/luci-oxidns-package.out 2>&1; then
				printf '{"ok":true,"action":"remove"}\n'
			else
				json_error "package_remove_failed" "$(cat /tmp/luci-oxidns-package.out 2>/dev/null || true)"
				return 1
			fi
			;;
		*)
			json_error "package_manager_unavailable" "opkg or apk not found"
			return 1
			;;
	esac
}

case "${1:-}" in
	list)
		printf '{'
		printf '"status":{},'
		printf '"package_manager":{},'
		printf '"package_check_update":{"manifest_url":"string"},'
		printf '"package_install":{"url":"string","sha256":"string"},'
		printf '"package_upgrade":{"url":"string","sha256":"string"},'
		printf '"package_remove":{},'
		printf '"service_start":{},'
		printf '"service_stop":{},'
		printf '"service_restart":{},'
		printf '"service_enable":{},'
		printf '"service_disable":{},'
		printf '"config_read":{},'
		printf '"config_validate":{"content":"string"},'
		printf '"config_save":{"content":"string","base_mtime":"string","reload":"boolean"},'
		printf '"config_basic_read":{},'
		printf '"config_basic_save":{"log_level":"string","api_http_listen":"string","base_mtime":"string","reload":"boolean"},'
		printf '"logs_recent":{"limit":"number"}'
		printf '}\n'
		;;
	call)
		case "${2:-}" in
			status)
				emit_status
				;;
			package_manager)
				emit_package_manager
				;;
			package_check_update)
				emit_package_check_update
				;;
			package_install)
				emit_package_install install
				;;
			package_upgrade)
				emit_package_install upgrade
				;;
			package_remove)
				emit_package_remove
				;;
			service_start)
				run_service start
				;;
			service_stop)
				run_service stop
				;;
			service_restart)
				run_service restart
				;;
			service_enable)
				run_service enable
				;;
			service_disable)
				run_service disable
				;;
			config_read)
				emit_config_read
				;;
			config_validate)
				emit_config_validate
				;;
			config_save)
				emit_config_save
				;;
			config_basic_read)
				emit_config_basic_read
				;;
			config_basic_save)
				emit_config_basic_save
				;;
			logs_recent)
				emit_logs_recent
				;;
			*)
				printf '{"ok":false,"error":"unknown method"}\n'
				exit 1
				;;
		esac
		;;
	*)
		printf '{"ok":false,"error":"usage: luci.oxidns list|call <method>"}\n'
		exit 1
		;;
esac
